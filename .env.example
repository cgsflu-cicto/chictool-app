# Copy this file to .env as a reference. The Electron app does not load .env
# automatically; set these in the environment used to launch the app.

# Angular development server URL. Leave empty to load the built local UI.
# `npm run dev` sets this to http://localhost:4200 automatically.
CHICTOOL_WEB_URL=

# HTTP port for the network scan endpoint and its Windows Firewall exception.
CHICTOOL_SCAN_PORT=4783

# Optional default sync server URL. A server URL saved in app settings takes precedence.
CHICTOOL_SERVER_URL=

# Optional default Mobile Hotspot network name. Leave empty for a generated name.
CHICTOOL_HOTSPOT_NAME=

# Runtime-managed values; the app sets these itself. Do not set them for normal use.
# PORTABLE_EXECUTABLE_DIR is supplied by the portable Electron build.
# PCINFO_DATA_DIR is set by the app to the correct local or portable data folder.
